package {
    default_applicable_licenses: ["hardware_interfaces_license"],
}

cc_library {
    name: "android.hardware.audiocontrol.internal",
    vendor_available: true,
    srcs: [
        "src/CarAudioConfigurationXmlConverter.cpp",
        "src/CarAudioConfigurationUtils.cpp",
    ],
    export_include_dirs: [
        "include",
    ],
    defaults: [
        "latest_android_hardware_audio_common_ndk_static",
        "latest_android_hardware_automotive_audiocontrol_ndk_shared",
        "car.audio.configuration.xsd.default",
        "car.fade.configuration.xsd.default",
        "latest_android_media_audio_common_types_ndk_static",
    ],
    shared_libs: [
        "libbase",
        "libutils",
        "libmedia_helper",
        "car.audio.configuration.xsd.default",
        "car.fade.configuration.xsd.default",
        "liblog",
        "libalsautilsv2",
        "libaudio_aidl_conversion_common_ndk",
        "libaudioaidlcommon",
        "libaudioutils",
        "libbinder_ndk",
        "libcutils",
        "libfmq",
        "libstagefright_foundation",
        "libtinyalsav2",
        "libxml2",
        "android.hardware.common-V2-ndk",
        "android.hardware.common.fmq-V1-ndk",
    ],
    static_libs: [
        "libaudio_aidl_conversion_common_ndk_cpp",
    ],
    header_libs: [
        "libaudio_system_headers",
        "libaudioaidl_headers",
        "libxsdc-utils",
    ],
    cflags: [
        "-DBACKEND_NDK",
    ],
    target: {
        vendor: {
            shared_libs: ["libnbaio_mono"],
        },
    },
}
